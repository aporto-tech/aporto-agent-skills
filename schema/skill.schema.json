{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aporto Agent Skill",
  "type": "object",
  "required": ["id", "name", "description", "tags", "when_to_use"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "concept": {
      "type": "object",
      "description": "Optional shared skill concept. Multiple source variants can map to the same concept.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "when_to_use": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context_cost": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "source": {
      "type": "object",
      "description": "Instruction source, maintainer, or author. This is not an API/model provider.",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
