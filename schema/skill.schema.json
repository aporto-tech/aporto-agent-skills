{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aporto Agent Skill",
  "type": "object",
  "required": ["id", "name", "description", "tags", "when_to_use"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "when_to_use": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "context_cost": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  },
  "additionalProperties": true
}

